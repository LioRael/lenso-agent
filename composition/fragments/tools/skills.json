{
  "composition": {
    "modules": [
      {
        "key": "skills",
        "package": "lenso.agent.skills.filesystem",
        "configuration": {
          "root": "~/.agents/skills",
          "max_skills": 256,
          "max_file_bytes": 262144,
          "max_total_bytes": 8388608,
          "max_catalog_bytes": 262144,
          "catalog_contribution_id": "agents.skills.catalog",
          "max_prompt_catalog_bytes": 8000,
          "max_resource_entries": 8192,
          "max_resource_file_bytes": 262144,
          "max_resource_total_bytes": 16777216,
          "max_resource_manifest_bytes": 524288
        },
        "configuration_schema": "crates/lenso-agent-skills-filesystem-module/config.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.tool-provider@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "catalog",
              "execute"
            ],
            "admission": {
              "queue_capacity": 4,
              "max_concurrency": 1
            }
          },
          {
            "capability_id": "lenso.agent.prompt-provider@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "contribute"
            ],
            "admission": {
              "queue_capacity": 1,
              "max_concurrency": 1
            }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      }
    ],
    "bindings": [
      {
        "consumer": "tools",
        "capability_id": "lenso.agent.tool-provider@1",
        "descriptor_version": "1.0.0",
        "provider": "skills"
      },
      {
        "consumer": "prompt",
        "capability_id": "lenso.agent.prompt-provider@1",
        "descriptor_version": "1.0.0",
        "provider": "skills"
      }
    ]
  },
  "packages": {
    "lenso.agent.skills.filesystem": {
      "name": "lenso.agent.skills.filesystem",
      "package_name": "lenso-agent-skills-filesystem-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    }
  },
  "contracts": []
}
