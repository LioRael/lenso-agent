{
  "composition": {
    "modules": [
      {
        "key": "cli",
        "package": "lenso.agent.cli",
        "requires": [
          {
            "capability_id": "lenso.agent@1",
            "descriptor_version": "1.1.0",
            "cardinality": "one"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "prompt",
        "package": "lenso.agent.prompt",
        "configuration": {
          "max_contributions": 16,
          "max_total_bytes": 65536
        },
        "configuration_schema": "crates/lenso-agent-prompt-module/config.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.prompt@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "assemble"
            ],
            "admission": {
              "queue_capacity": 4,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.agent.prompt-provider@1",
            "descriptor_version": "1.0.0",
            "cardinality": "many"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "tools",
        "package": "lenso.agent.tools",
        "provides": [
          {
            "capability_id": "lenso.agent.tools@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "catalog",
              "execute"
            ],
            "admission": {
              "queue_capacity": 4,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.agent.tool-provider@1",
            "descriptor_version": "1.0.0",
            "cardinality": "many"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "sessions",
        "package": "lenso.agent.session.file",
        "configuration": {
          "directory": ".lenso/sessions"
        },
        "configuration_schema": "composition/headless-readonly/config/session-file.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.session@1",
            "descriptor_version": "1.1.0",
            "operations": [
              "append",
              "open",
              "read"
            ],
            "admission": {
              "queue_capacity": 8,
              "max_concurrency": 1
            }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      }
    ],
    "bindings": [
      {
        "consumer": "cli",
        "capability_id": "lenso.agent@1",
        "descriptor_version": "1.1.0",
        "provider": "agent"
      },
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.prompt@1",
        "descriptor_version": "1.0.0",
        "provider": "prompt"
      },
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.tools@1",
        "descriptor_version": "1.0.0",
        "provider": "tools"
      },
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.session@1",
        "descriptor_version": "1.1.0",
        "provider": "sessions"
      }
    ]
  },
  "packages": {
    "lenso.agent.cli": {
      "name": "lenso.agent.cli",
      "package_name": "lenso-agent-cli-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.prompt": {
      "name": "lenso.agent.prompt",
      "package_name": "lenso-agent-prompt-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.tools": {
      "name": "lenso.agent.tools",
      "package_name": "lenso-agent-tools-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.session.file": {
      "name": "lenso.agent.session.file",
      "package_name": "lenso-agent-session-file-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    }
  },
  "cargo_contracts": [
    "lenso-capability-agent",
    "lenso-capability-agent-prompt",
    "lenso-capability-agent-prompt-provider",
    "lenso-capability-agent-tools",
    "lenso-capability-agent-tool-provider",
    "lenso-capability-agent-session"
  ]
}
