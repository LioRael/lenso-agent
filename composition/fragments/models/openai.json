{
  "composition": {
    "modules": [
      {
        "key": "agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "model": "gpt-4o-mini",
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_output_tokens": 1024,
          "max_history_events": 200
        },
        "configuration_schema": "crates/lenso-agent-loop-module/config.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent@1",
            "descriptor_version": "1.1.0",
            "operations": [
              "run_turn"
            ],
            "operation_kinds": {
              "run_turn": "stream"
            },
            "admission": {
              "queue_capacity": 0,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.agent.model@1",
            "descriptor_version": "1.1.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.prompt@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.tools@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.session@1",
            "descriptor_version": "1.1.0",
            "cardinality": "one"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "model",
        "package": "lenso.agent.model.openai-compatible",
        "configuration": {
          "base_url": "https://api.openai.com/v1",
          "model": "gpt-4o-mini",
          "api_key_ref": "model/openai-api-key"
        },
        "configuration_schema": "composition/openai-readonly/config/model.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.model@1",
            "descriptor_version": "1.1.0",
            "operations": [
              "complete"
            ],
            "operation_kinds": {
              "complete": "stream"
            },
            "admission": {
              "queue_capacity": 1,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.secrets@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "secrets",
        "package": "lenso.secrets.env",
        "configuration": {
          "references": {
            "model/openai-api-key": "OPENAI_API_KEY"
          }
        },
        "configuration_schema": "composition/openai-readonly/config/secrets-env.schema.json",
        "provides": [
          {
            "capability_id": "lenso.secrets@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "resolve"
            ],
            "admission": {
              "queue_capacity": 2,
              "max_concurrency": 1
            }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      }
    ],
    "bindings": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.model@1",
        "descriptor_version": "1.1.0",
        "provider": "model"
      },
      {
        "consumer": "model",
        "capability_id": "lenso.secrets@1",
        "descriptor_version": "1.0.0",
        "provider": "secrets"
      }
    ]
  },
  "packages": {
    "lenso.agent.loop": {
      "name": "lenso.agent.loop",
      "package_name": "lenso-agent-loop-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.model.openai-compatible": {
      "name": "lenso.agent.model.openai-compatible",
      "package_name": "lenso-agent-model-openai-compatible-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.secrets.env": {
      "name": "lenso.secrets.env",
      "package_name": "lenso-secrets-env-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    }
  },
  "cargo_contracts": [
    "lenso-capability-agent-model",
    "lenso-capability-secrets"
  ]
}
