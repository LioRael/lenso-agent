{
  "composition": {
    "modules": [
      {
        "key": "agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "model": "gpt-5.6-luna",
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_output_tokens": 4096,
          "max_history_events": 200
        },
        "configuration_schema": "composition/headless-readonly/config/agent-loop.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent@1",
            "descriptor_version": "1.1.0",
            "operations": [
              "run_turn"
            ],
            "operation_kinds": {
              "run_turn": "stream"
            },
            "admission": {
              "queue_capacity": 0,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.agent.model@1",
            "descriptor_version": "1.1.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.prompt@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.tools@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          },
          {
            "capability_id": "lenso.agent.session@1",
            "descriptor_version": "1.1.0",
            "cardinality": "one"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "model",
        "package": "lenso.agent.model.openai-codex-direct",
        "configuration": {
          "base_url": "https://chatgpt.com/backend-api",
          "model": "gpt-5.6-luna",
          "reasoning_effort": "medium",
          "max_event_bytes": 1048576
        },
        "configuration_schema": "crates/lenso-agent-model-openai-codex-direct-module/config.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.model@1",
            "descriptor_version": "1.1.0",
            "operations": [
              "complete"
            ],
            "operation_kinds": {
              "complete": "stream"
            },
            "admission": {
              "queue_capacity": 1,
              "max_concurrency": 1
            }
          }
        ],
        "requires": [
          {
            "capability_id": "lenso.agent.auth.openai-codex@1",
            "descriptor_version": "1.0.0",
            "cardinality": "one"
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "auth",
        "package": "lenso.agent.auth.openai-codex",
        "configuration": {
          "issuer": "https://auth.openai.com",
          "profile": "default",
          "refresh_margin_seconds": 60
        },
        "configuration_schema": "crates/lenso-agent-auth-openai-codex-module/config.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.auth.openai-codex@1",
            "descriptor_version": "1.0.0",
            "operations": [
              "access"
            ],
            "admission": {
              "queue_capacity": 1,
              "max_concurrency": 1
            }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      }
    ],
    "bindings": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.model@1",
        "descriptor_version": "1.1.0",
        "provider": "model"
      },
      {
        "consumer": "model",
        "capability_id": "lenso.agent.auth.openai-codex@1",
        "descriptor_version": "1.0.0",
        "provider": "auth"
      }
    ]
  },
  "packages": {
    "lenso.agent.loop": {
      "name": "lenso.agent.loop",
      "package_name": "lenso-agent-loop-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.model.openai-codex-direct": {
      "name": "lenso.agent.model.openai-codex-direct",
      "package_name": "lenso-agent-model-openai-codex-direct-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    },
    "lenso.agent.auth.openai-codex": {
      "name": "lenso.agent.auth.openai-codex",
      "package_name": "lenso-agent-auth-openai-codex-module",
      "source": "cargo",
      "version": "0.1.0",
      "manifest": "Cargo.toml",
      "lockfile": "Cargo.lock"
    }
  },
  "cargo_contracts": [
    "lenso-capability-agent-model",
    "lenso-capability-agent-auth-openai-codex"
  ]
}
