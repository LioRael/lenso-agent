{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ExtensionRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExtensionAssociation": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "ExtensionRecord": {
      "type": "object",
      "required": [
        "namespace",
        "schema_version",
        "event_id",
        "sequence",
        "idempotency_key",
        "owner_instance",
        "association",
        "payload_json",
        "presentation",
        "recovery_required"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "owner_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Trusted producer identity derived by the selected Provider from the\nresolved caller, rather than copied from `AppendRequest`."
        },
        "association": {
          "$ref": "#/$defs/ExtensionAssociation"
        },
        "payload_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 65536
        },
        "presentation": {
          "$ref": "#/$defs/SafePresentation"
        },
        "recovery_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SafePresentation": {
      "type": "object",
      "required": ["kind", "title", "summary", "attributes_json"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "description": "A trusted presentation type selected by an already installed package.\nIt is descriptive data only; it is never a code-loading instruction."
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "maxLength": 4096
        },
        "attributes_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16384,
          "description": "A bounded JSON object for safe, text-only inspection metadata."
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ReadResponse"
}
