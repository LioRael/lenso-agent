{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["namespace", "association", "limit"],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "association": {
      "$ref": "#/$defs/ExtensionAssociation"
    },
    "after_sequence": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 20
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExtensionAssociation": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ReadRequest"
}
