{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands"],
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "insert_text", "description"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "insert_text": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
