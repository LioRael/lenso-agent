{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["label", "connected", "methods"],
  "properties": {
    "label": {
      "type": "string",
      "description": "Provider-owned display name, not a package identifier."
    },
    "connected": {
      "type": "boolean",
      "description": "Presence of a stored grant, not proof that a remote service accepts it."
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LoginMethod"
      }
    },
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectionAccount"
        },
        {
          "type": "null"
        }
      ],
      "description": "Non-secret provider presentation for account management only."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ConnectionAccount": {
      "type": "object",
      "required": ["origin", "reconnect_required"],
      "properties": {
        "origin": {
          "type": "string"
        },
        "subject": {
          "type": ["string", "null"],
          "description": "Authenticated subject returned by the business App, never chosen by Agent."
        },
        "expires_at_millis": {
          "type": ["string", "null"]
        },
        "reconnect_required": {
          "type": "boolean",
          "description": "True after local expiry or an explicit remote authentication rejection."
        }
      },
      "additionalProperties": false
    },
    "LoginMethod": {
      "type": "string",
      "enum": ["device_code", "browser_loopback", "browser_consent"]
    }
  },
  "title": "StatusResponse"
}
