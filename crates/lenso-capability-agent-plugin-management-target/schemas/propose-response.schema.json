{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "agent_id",
    "authority",
    "application",
    "base_revision",
    "base_source_digest",
    "candidate_revision",
    "diagnostics",
    "instance",
    "plugin_id",
    "proposal_digest",
    "schema",
    "status"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority": {
      "$ref": "#/$defs/AuthoritySource"
    },
    "application": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "base_revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "base_source_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "candidate_revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ProposalDiagnostic"
      }
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AuthoritySource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "ProposalDiagnostic": {
      "type": "object",
      "required": ["code", "detail"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ProposeResponse"
}
