{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agent_id", "authority", "entries", "query", "revision"],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority": {
      "$ref": "#/$defs/AuthoritySource"
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      }
    },
    "query": {
      "type": "string",
      "maxLength": 128
    },
    "revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AuthoritySource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "CatalogEntry": {
      "type": "object",
      "required": ["catalog_entry_id", "package_id", "package_revision", "source_digest"],
      "properties": {
        "catalog_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "package_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "package_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "additionalProperties": false
    }
  },
  "title": "CatalogResponse"
}
