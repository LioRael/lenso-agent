{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "agent_id",
    "authority",
    "base_revision",
    "base_source_digest",
    "proposal_digest",
    "revision",
    "rollback_of_proposal_digest",
    "schema"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority": {
      "$ref": "#/$defs/AuthoritySource"
    },
    "base_revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "base_source_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "proposal_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "rollback_of_proposal_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AuthoritySource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  },
  "title": "PublishRollbackResponse"
}
