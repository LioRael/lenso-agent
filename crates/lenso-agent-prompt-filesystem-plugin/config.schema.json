  "properties": {
    "root": { "type": "string" },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "id_prefix": { "type": "string" },
    "max_file_bytes": { "type": "integer" },
    "max_total_bytes": { "type": "integer" }
  },
  "additionalProperties": false
}
