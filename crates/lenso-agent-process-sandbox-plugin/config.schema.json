{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "temporary_directory",
    "backend",
    "allow_network",
    "allowed_programs",
    "environment_allowlist",
    "max_timeout_ms",
    "max_output_bytes",
    "max_argument_bytes"
  ],
  "properties": {
    "root": { "type": "string" },
    "temporary_directory": { "type": "string" },
    "backend": { "type": "string" },
    "allow_network": { "type": "boolean" },
    "allowed_programs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "program_presets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["rust", "javascript", "python", "go", "build"]
      }
    },
    "environment_allowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_timeout_ms": { "type": "integer" },
    "max_output_bytes": { "type": "integer" },
    "max_argument_bytes": { "type": "integer" }
  }
}
