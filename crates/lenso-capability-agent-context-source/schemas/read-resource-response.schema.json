{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contents"],
  "properties": {
    "contents": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ResourceContent"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ResourceContent": {
      "type": "object",
      "required": ["uri", "mime_type", "text"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mime_type": {
          "type": "string",
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ReadResourceResponse"
}
