{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["prompts", "resources"],
  "properties": {
    "prompts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/PromptDefinition"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/ResourceDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PromptDefinition": {
      "type": "object",
      "required": ["source", "name", "description", "arguments_schema_json"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "arguments_schema_json": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    },
    "ResourceDefinition": {
      "type": "object",
      "required": ["source", "uri", "name", "description", "mime_type"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "mime_type": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  },
  "title": "SnapshotResponse"
}
