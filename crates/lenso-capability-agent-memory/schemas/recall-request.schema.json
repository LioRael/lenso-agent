{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["session_id", "query", "max_items", "max_characters"],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_characters": {
      "type": "integer",
      "minimum": 256,
      "maximum": 262144
    }
  },
  "additionalProperties": false,
  "title": "RecallRequest"
}
