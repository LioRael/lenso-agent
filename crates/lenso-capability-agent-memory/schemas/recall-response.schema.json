{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/MemoryItem"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "MemoryItem": {
      "type": "object",
      "required": ["memory_id", "content", "source", "confidence_milli"],
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "source": {
          "$ref": "#/$defs/MemorySource"
        },
        "confidence_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "MemorySource": {
      "type": "object",
      "required": ["session_id", "turn_id"],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
  "title": "RecallResponse"
}
