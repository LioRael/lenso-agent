{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "const": "invalid_request" },
    { "const": "target_not_found" },
    { "const": "stale_catalog" },
    { "const": "tool_not_found" },
    { "const": "permission_denied" },
    {
      "type": "object",
      "required": ["code", "payload"],
      "properties": {
        "code": { "const": "execution_failed" },
        "payload": {
          "type": "object",
          "required": ["reason_code", "message", "details_json"],
          "properties": {
            "reason_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "details_json": {
              "type": "string",
              "minLength": 2,
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "title": "ExecutionFailedPayload"
        }
      },
      "additionalProperties": false
    }
  ]
}
