{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["messages", "tools", "transformation_id", "transformation_version"],
  "properties": {
    "messages": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/ModelMessage"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/ModelTool"
      }
    },
    "transformation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transformation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ModelImage": {
      "type": "object",
      "required": ["media_type", "data_base64"],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "data_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2796204
        }
      },
      "additionalProperties": false
    },
    "ModelMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {
          "$ref": "#/$defs/ModelMessageRole"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "images": {
          "type": ["array", "null"],
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ModelImage"
          }
        },
        "tool_call_id": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "tool_name": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "arguments_json": {
          "type": ["string", "null"],
          "maxLength": 262144
        }
      },
      "additionalProperties": false,
      "description": "The model-visible message form intentionally excludes execution authority."
    },
    "ModelMessageRole": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "ModelTool": {
      "type": "object",
      "required": ["name", "description", "input_schema_json"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "input_schema_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ProjectModelResponse"
}
