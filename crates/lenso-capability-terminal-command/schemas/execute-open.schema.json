{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "arguments_json", "output_format"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arguments_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "output_format": {
      "$ref": "#/$defs/OutputFormat"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "OutputFormat": {
      "type": "string",
      "enum": ["text", "json"]
    }
  },
  "title": "ExecuteOpen"
}
