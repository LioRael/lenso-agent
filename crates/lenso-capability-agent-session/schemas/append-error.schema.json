{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppendSessionError",
  "oneOf": [
    { "const": "not_found" },
    { "const": "invalid_event" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "payload"],
      "properties": {
        "code": {
          "const": "revision_conflict"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current_revision"],
          "properties": {
            "current_revision": {
              "type": "string",
              "format": "uint64"
            }
          }
        }
      }
    }
  ]
}
