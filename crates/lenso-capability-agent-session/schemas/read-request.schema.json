{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadSessionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "after_revision", "limit"],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "after_revision": {
      "type": "string",
      "format": "uint64"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
