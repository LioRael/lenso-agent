{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSessionRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "create_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Idempotently create or open this caller-selected ID. Mutually exclusive with session_id."
    }
  }
}
