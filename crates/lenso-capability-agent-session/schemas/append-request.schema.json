{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppendSessionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "expected_revision", "events"],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_revision": {
      "type": "string",
      "format": "uint64"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "kind", "occurred_at", "payload_json"],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "session_created",
              "system_instruction_installed",
              "context_compaction_started",
              "context_compaction_committed",
              "context_compaction_failed",
              "memory_recalled",
              "memory_recall_failed",
              "memory_committed",
              "memory_commit_failed",
              "turn_started",
              "model_requested",
              "model_output",
              "tool_requested",
              "tool_result",
              "turn_completed",
              "turn_failed",
              "turn_cancelled"
            ]
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "payload_json": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1048576
          }
        }
      }
    }
  }
}
