{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sequence",
    "kind",
    "text",
    "tool_call_id",
    "tool_name",
    "arguments_json",
    "input_tokens",
    "output_tokens"
  ],
  "properties": {
    "sequence": {
      "type": "string",
      "format": "uint64"
    },
    "kind": {
      "$ref": "#/$defs/CompleteMessageKind"
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "tool_call_id": {
      "type": "string",
      "maxLength": 128
    },
    "tool_name": {
      "type": "string",
      "maxLength": 128
    },
    "arguments_json": {
      "type": "string",
      "maxLength": 262144
    },
    "input_tokens": {
      "type": "string",
      "format": "uint64"
    },
    "output_tokens": {
      "type": "string",
      "format": "uint64"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CompleteMessageKind": {
      "type": "string",
      "enum": ["reasoning_summary_delta", "text_delta", "tool_call", "usage"]
    }
  },
  "title": "CompleteMessage"
}
