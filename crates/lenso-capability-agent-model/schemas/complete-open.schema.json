{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["model", "messages", "tools", "temperature", "max_output_tokens"],
  "properties": {
    "continuation_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional caller-owned affinity hint for consecutive completions in one\nisolated task. Providers may ignore it. Full messages remain authoritative;\nthis is neither a provider response ID nor authorization or durable state."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "messages": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/CompleteMessageInput"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/CompleteTool"
      }
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "reasoning_enabled": {
      "type": "boolean"
    },
    "reasoning_budget_tokens": {
      "type": "string",
      "format": "uint64"
    },
    "service_tier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CompleteMessageInput": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {
          "$ref": "#/$defs/CompleteMessageRole"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "maxLength": 128
        },
        "arguments_json": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "additionalProperties": false
    },
    "CompleteMessageRole": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "CompleteTool": {
      "type": "object",
      "required": ["name", "description", "input_schema_json"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "input_schema_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    }
  },
  "title": "CompleteOpen"
}
