{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "const": "unknown_tool" },
    { "const": "invalid_arguments" },
    {
      "type": "object",
      "required": ["code", "payload"],
      "properties": {
        "code": { "const": "tool_error" },
        "payload": {
          "type": "object",
          "required": ["provider_code", "message", "details_json"],
          "properties": {
            "provider_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "details_json": {
              "type": "string",
              "minLength": 2,
              "maxLength": 65536
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
