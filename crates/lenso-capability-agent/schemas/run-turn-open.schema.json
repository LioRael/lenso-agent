{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "input"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input": {
      "type": "string",
      "minLength": 0,
      "maxLength": 262144
    },
    "attachments": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "media_type",
          "data_base64"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "text/plain"
            ]
          },
          "data_base64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2796204
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
