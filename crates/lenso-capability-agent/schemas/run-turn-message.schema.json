{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sequence", "text"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["text_delta", "tool_started", "tool_completed", "tool_failed"]
    },
    "sequence": {
      "type": "string",
      "format": "uint64"
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arguments_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "content": {
      "type": "string",
      "maxLength": 1048576
    },
    "metadata_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 65536
    },
    "duration_ms": {
      "type": "string",
      "format": "uint64"
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "additionalProperties": false
}
