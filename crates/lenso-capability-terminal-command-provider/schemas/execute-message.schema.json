{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "content_type", "content"],
  "properties": {
    "kind": {
      "$ref": "#/$defs/OutputKind"
    },
    "content_type": {
      "$ref": "#/$defs/ContentType"
    },
    "content": {
      "type": "string",
      "maxLength": 1048576
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ContentType": {
      "type": "string",
      "enum": ["text", "json"]
    },
    "OutputKind": {
      "type": "string",
      "enum": ["stdout", "stderr", "progress", "result"]
    }
  },
  "title": "ExecuteMessage"
}
