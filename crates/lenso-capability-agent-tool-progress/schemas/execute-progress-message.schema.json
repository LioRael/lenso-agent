{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "content_type", "content", "metadata_json"],
  "properties": {
    "kind": {
      "$ref": "#/$defs/ExecuteProgressKind"
    },
    "content_type": {
      "$ref": "#/$defs/ContentType"
    },
    "content": {
      "type": "string",
      "maxLength": 1048576
    },
    "metadata_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 65536
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ContentType": {
      "type": "string",
      "enum": ["text"]
    },
    "ExecuteProgressKind": {
      "type": "string",
      "enum": ["stdout", "stderr", "completed"]
    }
  },
  "title": "ExecuteProgress"
}
