{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/ToolProgressDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ToolProgressDefinition": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
  "title": "CatalogResponse"
}
