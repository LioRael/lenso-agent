{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["programs"],
  "properties": {
    "programs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
