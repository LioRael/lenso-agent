{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["panels"],
  "properties": {
    "panels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "type": "string", "maxLength": 65536 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
