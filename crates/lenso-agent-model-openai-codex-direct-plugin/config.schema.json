{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_url", "model", "reasoning_effort", "max_event_bytes"],
  "properties": {
    "transport": {
      "type": "string",
      "enum": ["sse", "websocket", "auto"],
      "default": "websocket",
      "description": "Responses transport. Auto falls back only when the WebSocket handshake returns HTTP 426, before any model request is sent."
    },
    "base_url": { "type": "string" },
    "model": { "type": "string" },
    "allowed_models": {
      "deprecated": true,
      "type": "array",
      "items": { "type": "string" }
    },
    "include_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "catalog_cache_path": { "type": "string" },
    "catalog_max_stale_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_snapshot_path": {
      "type": "string",
      "description": "Compatibility name for the Provider-owned effective catalog publication path."
    },
    "catalog_refresh_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "reasoning_effort": { "type": "string" },
    "max_event_bytes": { "type": "integer" }
  }
}
