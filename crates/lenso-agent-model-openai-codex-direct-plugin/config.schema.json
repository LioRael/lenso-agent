{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_url", "model", "reasoning_effort", "max_event_bytes"],
  "properties": {
    "base_url": { "type": "string" },
    "model": { "type": "string" },
    "allowed_models": {
      "deprecated": true,
      "type": "array",
      "items": { "type": "string" }
    },
    "include_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reasoning_effort": { "type": "string" },
    "max_event_bytes": { "type": "integer" }
  }
}
