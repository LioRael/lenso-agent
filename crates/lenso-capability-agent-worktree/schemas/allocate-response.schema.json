{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "workspace"],
  "properties": {
    "kind": {
      "$ref": "#/$defs/WorkspaceAllocationKind"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "branch": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 255
    }
  },
  "additionalProperties": false,
  "$defs": {
    "WorkspaceAllocationKind": {
      "type": "string",
      "enum": ["current", "isolated_worktree"]
    }
  },
  "title": "AllocateResponse"
}
