{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["transport", "protocol", "tool_namespace", "startup_timeout_ms", "request_timeout_ms"],
  "properties": {
    "transport": { "title": "Transport", "enum": ["stdio", "streamable_http"] },
    "program": true,
    "arguments": true,
    "working_directory": true,
    "environment_allowlist": true,
    "endpoint": true,
    "authorization_environment": true,
    "oauth_resource": true,
    "oauth_scopes": true,
    "protocol": { "enum": ["auto", "modern", "legacy"] },
    "tool_namespace": { "type": "string" },
    "startup_timeout_ms": { "type": "integer" },
    "request_timeout_ms": { "type": "integer" },
    "allow_elicitation": { "type": "boolean" },
    "allow_sampling": { "type": "boolean" },
    "roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "name"],
        "properties": {
          "uri": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "parallel_safe_tools": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "continuation_max_rounds": { "type": "integer" },
    "sampling_model": { "type": "string" },
    "max_sampling_tokens": { "type": "integer" }
  },
  "$comment": "Transport fields are evaluated by the selected branch. Inactive values are retained but not consumed; unknown keys remain forbidden.",
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "stdio" } }, "required": ["transport"] },
      "then": {
        "required": ["program", "arguments", "working_directory", "environment_allowlist"],
        "properties": {
          "program": { "title": "Program", "description": "Absolute path to the MCP server executable.", "type": "string" },
          "arguments": { "title": "Arguments", "type": "array", "items": { "type": "string" } },
          "working_directory": { "title": "Working directory", "type": "string" },
          "environment_allowlist": { "title": "Environment variables", "description": "Host environment variable names passed to the server, not their values.", "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "if": { "properties": { "transport": { "const": "streamable_http" } }, "required": ["transport"] },
      "then": {
        "required": ["endpoint"],
        "properties": {
          "endpoint": { "title": "Endpoint", "description": "HTTPS endpoint, or HTTP on loopback for local servers.", "type": "string" },
          "authorization_environment": { "title": "Authorization environment variable", "description": "Name of the Host variable containing the full Authorization header. Use this or OAuth, not both.", "type": "string" },
          "oauth_resource": { "title": "OAuth resource", "description": "Resource URI on the same origin as the endpoint. Tokens are managed by the Auth Plugin.", "type": "string" },
          "oauth_scopes": { "title": "OAuth scopes", "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "title": "Connection",
      "description": "Choose how to connect to the MCP server.",
      "properties": {
        "transport": true,
        "program": true,
        "arguments": true,
        "working_directory": true,
        "environment_allowlist": true,
        "endpoint": true,
        "authorization_environment": true,
        "oauth_resource": true,
        "oauth_scopes": true
      }
    },
    {
      "title": "Behavior",
      "description": "Tool naming, protocol negotiation and request limits.",
      "properties": {
        "tool_namespace": true,
        "protocol": true,
        "startup_timeout_ms": true,
        "request_timeout_ms": true
      }
    },
    {
      "title": "Advanced",
      "description": "Optional server interactions, sampling and parallel execution.",
      "properties": {
        "allow_elicitation": true,
        "allow_sampling": true,
        "sampling_model": true,
        "max_sampling_tokens": true,
        "roots": true,
        "parallel_safe_tools": true,
        "continuation_max_rounds": true
      }
    }
  ]
}
