{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["revision", "compacted_through_revision", "source_message_count"],
  "properties": {
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "compacted_through_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "source_message_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "title": "CompactSessionResponse"
}
