{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "signal_id", "expected_revision", "kind", "payload_json"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "expected_revision": {
      "type": "string",
      "format": "uint64",
      "description": "The state revision the signal was approved for. A stale or mismatched\nsignal must not resume a later state transition."
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 65536
    }
  },
  "additionalProperties": false,
  "title": "SignalRequest"
}
