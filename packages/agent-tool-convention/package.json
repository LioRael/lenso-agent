{
  "name": "@lenso/agent-tools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lenso/bun-plugin": "0.4.1",
    "@lenso/contract-runtime": "0.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.0",
    "typescript-ast": "npm:typescript@5.9.3"
