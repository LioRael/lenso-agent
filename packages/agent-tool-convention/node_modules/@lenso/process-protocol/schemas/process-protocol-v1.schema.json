{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/schemas/process-protocol-v1.schema.json",
  "title": "Lenso Process Protocol V1 wire documents",
  "description": "Structural schema. Implementations additionally enforce canonical ordering, canonical encodings, duplicate-key rejection, and peer/session equality.",
  "oneOf": [
    { "$ref": "#/$defs/readiness" },
    { "$ref": "#/$defs/handshake_request" },
    { "$ref": "#/$defs/handshake_success" },
    { "$ref": "#/$defs/data_request" },
    { "$ref": "#/$defs/data_success" },
    { "$ref": "#/$defs/cancel_request" },
    { "$ref": "#/$defs/shutdown_request" },
    { "$ref": "#/$defs/control_success" }
    ,{ "$ref": "#/$defs/error_envelope" }
  ],
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "data_port", "control_port"],
      "properties": {
        "protocol": { "const": "lenso-process-jsonrpc-http-v1" },
        "data_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "control_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._@/:-]{1,256}$" },
    "base64url32": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "interaction"],
      "properties": {
        "operation": { "$ref": "#/$defs/token" },
        "interaction": { "const": "request" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "descriptor_version", "descriptor_digest", "operations"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/token" },
        "descriptor_version": { "$ref": "#/$defs/token" },
        "descriptor_digest": { "$ref": "#/$defs/digest" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "capability_id", "descriptor_version", "descriptor_digest", "provider_instance"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/token" },
        "capability_id": { "$ref": "#/$defs/token" },
        "descriptor_version": { "$ref": "#/$defs/token" },
        "descriptor_digest": { "$ref": "#/$defs/digest" },
        "provider_instance": { "$ref": "#/$defs/token" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_http_body_bytes", "max_control_http_body_bytes", "max_concurrent_requests", "child_request_queue_capacity", "max_retired_correlation_ids", "control_queue_capacity"],
      "properties": {
        "max_http_body_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_control_http_body_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_concurrent_requests": { "type": "integer", "minimum": 1, "maximum": 256 },
        "child_request_queue_capacity": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "max_retired_correlation_ids": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "control_queue_capacity": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_profile", "value_profile", "plugin_instance", "plugin_generation", "generation_spec_digest", "artifact_digest", "effective_host_grant_set_digest", "interaction_profiles", "provided_capabilities", "outbound_bindings", "peer_limits"],
      "properties": {
        "protocol_profile": { "const": "lenso-process-jsonrpc-http-v1" },
        "value_profile": { "const": "lenso-json-value-v1" },
        "plugin_instance": { "$ref": "#/$defs/token" },
        "plugin_generation": { "$ref": "#/$defs/decimal" },
        "generation_spec_digest": { "$ref": "#/$defs/digest" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "effective_host_grant_set_digest": { "$ref": "#/$defs/digest" },
        "interaction_profiles": {
          "type": "array",
          "const": ["provide-request-v1"]
        },
        "provided_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "outbound_bindings": {
          "type": "array",
          "maxItems": 0
        },
        "peer_limits": { "$ref": "#/$defs/limits" }
      }
    },
    "handshake_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "host_nonce", "host_proof"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "host_nonce": { "$ref": "#/$defs/base64url32" },
        "host_proof": { "$ref": "#/$defs/base64url32" }
      }
    },
    "handshake_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "session", "child_proof"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "session": { "$ref": "#/$defs/base64url32" },
        "child_proof": { "$ref": "#/$defs/base64url32" }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/token" },
        "value": { "type": "string", "contentEncoding": "base64" },
        "issuer": { "type": "string" },
        "audience": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "proof": { "type": "string" },
        "sealed": { "type": "boolean" }
      }
    },
    "request_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "correlation_id", "capability_id", "descriptor_version", "descriptor_digest", "operation", "interaction", "caller_instance", "remaining_timeout_nanos", "extensions", "payload"],
      "properties": {
        "session": { "$ref": "#/$defs/base64url32" },
        "correlation_id": { "$ref": "#/$defs/decimal" },
        "capability_id": { "$ref": "#/$defs/token" },
        "descriptor_version": { "$ref": "#/$defs/token" },
        "descriptor_digest": { "$ref": "#/$defs/digest" },
        "operation": { "$ref": "#/$defs/token" },
        "interaction": { "const": "request" },
        "caller_instance": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "remaining_timeout_nanos": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "extensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/extension" } },
        "payload": true
      }
    },
    "child_failure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation"],
          "properties": { "kind": { "const": "resource_exhausted" }, "operation": { "$ref": "#/$defs/token" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "detail"],
          "properties": { "kind": { "const": "plugin_failure" }, "detail": { "type": "string", "minLength": 1, "maxLength": 1024 } }
        }
      ]
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "success" }, "value": true } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "error"], "properties": { "kind": { "const": "domain" }, "error": true } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "failure"], "properties": { "kind": { "const": "runtime" }, "failure": { "$ref": "#/$defs/child_failure" } } }
      ]
    },
    "request_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "correlation_id", "outcome"],
      "properties": {
        "session": { "$ref": "#/$defs/base64url32" },
        "correlation_id": { "$ref": "#/$defs/decimal" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "cancel_params": {
      "type": "object", "additionalProperties": false, "required": ["session", "correlation_id"],
      "properties": { "session": { "$ref": "#/$defs/base64url32" }, "correlation_id": { "$ref": "#/$defs/decimal" } }
    },
    "shutdown_params": {
      "type": "object", "additionalProperties": false, "required": ["session"],
      "properties": { "session": { "$ref": "#/$defs/base64url32" } }
    },
    "control_ack": {
      "type": "object", "additionalProperties": false, "required": ["session", "accepted"],
      "properties": { "session": { "$ref": "#/$defs/base64url32" }, "accepted": { "const": true } }
    },
    "handshake_request": { "$ref": "#/$defs/request_envelope", "properties": { "method": { "const": "lenso.process.v1.handshake" }, "params": { "$ref": "#/$defs/handshake_params" } } },
    "data_request": { "$ref": "#/$defs/request_envelope", "properties": { "method": { "const": "lenso.process.v1.request" }, "params": { "$ref": "#/$defs/request_params" } } },
    "cancel_request": { "$ref": "#/$defs/request_envelope", "properties": { "method": { "const": "lenso.process.v1.cancel" }, "params": { "$ref": "#/$defs/cancel_params" } } },
    "shutdown_request": { "$ref": "#/$defs/request_envelope", "properties": { "method": { "const": "lenso.process.v1.shutdown" }, "params": { "$ref": "#/$defs/shutdown_params" } } },
    "handshake_success": { "$ref": "#/$defs/success_envelope", "properties": { "result": { "$ref": "#/$defs/handshake_result" } } },
    "data_success": { "$ref": "#/$defs/success_envelope", "properties": { "result": { "$ref": "#/$defs/request_result" } } },
    "control_success": { "$ref": "#/$defs/success_envelope", "properties": { "result": { "$ref": "#/$defs/control_ack" } } },
    "request_envelope": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/decimal" }, "method": { "type": "string" }, "params": { "type": "object" } }
    },
    "success_envelope": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/decimal" }, "result": { "type": "object" } }
    },
    "error_envelope": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "enum": [-32700, -32600, -32601, -32602, -32603] },
            "message": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
