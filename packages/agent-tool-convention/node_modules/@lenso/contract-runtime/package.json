{
  "name": "@lenso/contract-runtime",
  "version": "0.3.0",
  "description": "Runtime-neutral TypeScript wire support for generated Lenso Capability contracts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-protocols.git",
    "directory": "packages/lenso-contract-runtime"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs",
      "browser": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && bun build src/index.ts src/browser.ts --target=browser --format=esm --outdir=dist --entry-naming='[name].js' && bun build src/index.ts src/browser.ts --target=node --format=cjs --outdir=dist --entry-naming='[name].cjs' && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "smoke": "node test/package-esm.mjs && node test/package-cjs.cjs",
    "test": "bun test test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
