{
  "schema_version": 1,
  "composition": {
    "modules": [
      {
        "key": "cli",
        "package": "lenso.agent.cli",
        "requires": [
          { "capability_id": "lenso.agent@1", "descriptor_version": "1.1.0", "cardinality": "one" }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "model": "fixture/readme-summary-v1",
          "max_steps": 2,
          "max_tool_calls": 1,
          "max_output_tokens": 1024
        },
        "configuration_schema": "composition/headless-readonly/config/agent-loop.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent@1",
            "descriptor_version": "1.1.0",
            "operations": ["run_turn"],
            "operation_kinds": { "run_turn": "stream" },
            "admission": { "queue_capacity": 0, "max_concurrency": 1 }
          }
        ],
        "requires": [
          { "capability_id": "lenso.agent.model@1", "descriptor_version": "1.0.0", "cardinality": "one" },
          { "capability_id": "lenso.agent.tools@1", "descriptor_version": "1.0.0", "cardinality": "one" },
          { "capability_id": "lenso.agent.session@1", "descriptor_version": "1.1.0", "cardinality": "one" }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "model",
        "package": "lenso.agent.model.fixture",
        "configuration": { "model": "fixture/readme-summary-v1" },
        "configuration_schema": "composition/headless-readonly/config/model.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.model@1",
            "descriptor_version": "1.0.0",
            "operations": ["complete"],
            "operation_kinds": { "complete": "stream" },
            "admission": { "queue_capacity": 1, "max_concurrency": 1 }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "tools",
        "package": "lenso.agent.tools",
        "provides": [
          {
            "capability_id": "lenso.agent.tools@1",
            "descriptor_version": "1.0.0",
            "operations": ["catalog", "execute"],
            "admission": { "queue_capacity": 4, "max_concurrency": 1 }
          }
        ],
        "requires": [
          { "capability_id": "lenso.agent.tool-provider@1", "descriptor_version": "1.0.0", "cardinality": "many" }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "workspace-read",
        "package": "lenso.agent.workspace-read",
        "configuration": { "root": ".", "max_output_bytes": 1048576 },
        "configuration_schema": "composition/headless-readonly/config/workspace-read.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.tool-provider@1",
            "descriptor_version": "1.0.0",
            "operations": ["catalog", "execute"],
            "admission": { "queue_capacity": 4, "max_concurrency": 1 }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      },
      {
        "key": "sessions",
        "package": "lenso.agent.session.file",
        "configuration": { "directory": ".lenso/sessions" },
        "configuration_schema": "composition/headless-readonly/config/session-file.schema.json",
        "provides": [
          {
            "capability_id": "lenso.agent.session@1",
            "descriptor_version": "1.1.0",
            "operations": ["append", "open", "read"],
            "admission": { "queue_capacity": 8, "max_concurrency": 1 }
          }
        ],
        "execution_class": "lenso.native-rust@1"
      }
    ],
    "bindings": [
      { "consumer": "cli", "capability_id": "lenso.agent@1", "descriptor_version": "1.1.0", "provider": "agent" },
      { "consumer": "agent", "capability_id": "lenso.agent.model@1", "descriptor_version": "1.0.0", "provider": "model" },
      { "consumer": "agent", "capability_id": "lenso.agent.tools@1", "descriptor_version": "1.0.0", "provider": "tools" },
      { "consumer": "agent", "capability_id": "lenso.agent.session@1", "descriptor_version": "1.1.0", "provider": "sessions" },
      { "consumer": "tools", "capability_id": "lenso.agent.tool-provider@1", "descriptor_version": "1.0.0", "provider": "workspace-read" }
    ],
    "execution_lanes": [{ "id": "main" }]
  },
  "packages": {
    "lenso.agent.cli": { "name": "lenso.agent.cli", "package_name": "lenso-agent-cli-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" },
    "lenso.agent.loop": { "name": "lenso.agent.loop", "package_name": "lenso-agent-loop-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" },
    "lenso.agent.model.fixture": { "name": "lenso.agent.model.fixture", "package_name": "lenso-agent-model-fixture-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" },
    "lenso.agent.tools": { "name": "lenso.agent.tools", "package_name": "lenso-agent-tools-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" },
    "lenso.agent.workspace-read": { "name": "lenso.agent.workspace-read", "package_name": "lenso-agent-workspace-read-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" },
    "lenso.agent.session.file": { "name": "lenso.agent.session.file", "package_name": "lenso-agent-session-file-module", "source": "cargo", "version": "0.1.0", "manifest": "Cargo.toml", "lockfile": "Cargo.lock" }
  },
  "contracts": [
    { "capability_id": "lenso.agent@1", "descriptor_version": "1.1.0", "descriptor": "crates/lenso-capability-agent/capability.json", "rust": "crates/lenso-capability-agent/src/generated.rs", "typescript": "crates/lenso-capability-agent/generated/bindings.ts" },
    { "capability_id": "lenso.agent.model@1", "descriptor_version": "1.0.0", "descriptor": "crates/lenso-capability-agent-model/capability.json", "rust": "crates/lenso-capability-agent-model/src/generated.rs", "typescript": "crates/lenso-capability-agent-model/generated/bindings.ts" },
    { "capability_id": "lenso.agent.tools@1", "descriptor_version": "1.0.0", "descriptor": "crates/lenso-capability-agent-tools/capability.json", "rust": "crates/lenso-capability-agent-tools/src/generated.rs", "typescript": "crates/lenso-capability-agent-tools/generated/bindings.ts" },
    { "capability_id": "lenso.agent.tool-provider@1", "descriptor_version": "1.0.0", "descriptor": "crates/lenso-capability-agent-tool-provider/capability.json", "rust": "crates/lenso-capability-agent-tool-provider/src/generated.rs", "typescript": "crates/lenso-capability-agent-tool-provider/generated/bindings.ts" },
    { "capability_id": "lenso.agent.session@1", "descriptor_version": "1.1.0", "descriptor": "crates/lenso-capability-agent-session/capability.json", "rust": "crates/lenso-capability-agent-session/src/generated.rs", "typescript": "crates/lenso-capability-agent-session/generated/bindings.ts" }
  ],
  "profiles": {}
}
