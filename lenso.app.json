{
  "schema_version": 1,
  "manifest": "Cargo.toml",
  "host_package": "lenso-agent-cli",
  "packages": {
    "lenso.agent.cli": "lenso-agent-cli-module",
    "lenso.agent.discord": "lenso-agent-discord-module",
    "lenso.agent.http-fetch": "lenso-agent-http-fetch-module",
    "lenso.agent.loop": "lenso-agent-loop-module",
    "lenso.agent.model.fixture": "lenso-agent-model-fixture-module",
    "lenso.agent.prompt": "lenso-agent-prompt-module",
    "lenso.agent.prompt.static": "lenso-agent-prompt-static-module",
    "lenso.agent.session.file": "lenso-agent-session-file-module",
    "lenso.agent.tools": "lenso-agent-tools-module",
    "lenso.agent.tui": "lenso-agent-tui-module",
    "lenso.agent.tui.static": "lenso-agent-tui-static-module",
    "lenso.agent.telegram": "lenso-agent-telegram-module",
    "lenso.agent.tui-command-suggestions": "lenso-agent-tui-command-suggestions-module",
    "lenso.agent.tui-workspace-suggestions": "lenso-agent-tui-workspace-suggestions-module",
    "lenso.agent.workspace-read": "lenso-agent-workspace-read-module",
    "lenso.agent.workspace-read-tools": "lenso-agent-workspace-read-tools-module",
    "lenso.agent.workspace-import-read": "lenso-agent-workspace-import-read-module"
  },
  "app": {
    "name": "lenso-agent",
    "modules": [
      {
        "key": "agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "model": "fixture/readme-summary-v1",
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_parallel_tool_calls": 4,
          "max_output_tokens": 1024,
          "max_history_events": 200
        }
      },
      {
        "key": "cli",
        "package": "lenso.agent.cli"
      },
      {
        "key": "discord",
        "package": "lenso.agent.discord"
      },
      {
        "key": "http-fetch",
        "package": "lenso.agent.http-fetch",
        "configuration": {
          "allowed_origins": []
        }
      },
      {
        "key": "model",
        "package": "lenso.agent.model.fixture",
        "configuration": {
          "model": "fixture/readme-summary-v1"
        }
      },
      {
        "key": "prompt",
        "package": "lenso.agent.prompt"
      },
      {
        "key": "sessions",
        "package": "lenso.agent.session.file",
        "configuration": {
          "directory": ".lenso/sessions"
        }
      },
      {
        "key": "summary-skill",
        "package": "lenso.agent.prompt.static",
        "configuration": {
          "contributions": [
            {
              "id": "workspace.summary",
              "version": "1.0.0",
              "kind": "skill",
              "content": "When summarizing a workspace file, ground the answer in the Tool result."
            }
          ]
        }
      },
      {
        "key": "subagent-agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "model": "fixture/readme-summary-v1",
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_parallel_tool_calls": 4,
          "max_output_tokens": 1024,
          "max_history_events": 200
        }
      },
      {
        "key": "restricted-read-tools",
        "package": "lenso.agent.workspace-read-tools"
      },
      {
        "key": "tools",
        "package": "lenso.agent.tools"
      },
      {
        "key": "tui",
        "package": "lenso.agent.tui"
      },
      {
        "key": "tui-help",
        "package": "lenso.agent.tui.static",
        "configuration": {
          "panels": [
            {
              "id": "agent.help",
              "title": "Help",
              "body": "Enter sends a message.\nEsc cancels the active Turn or exits while idle.\nCtrl-C exits immediately.\nTab cycles contributed panels."
            }
          ]
        }
      },
      {
        "key": "telegram",
        "package": "lenso.agent.telegram"
      },
      {
        "key": "tui-commands",
        "package": "lenso.agent.tui-command-suggestions",
        "configuration": {
          "commands": [
            {
              "id": "agent.command.help",
              "label": "/help",
              "insert_text": "/help",
              "description": "Show keyboard shortcuts"
            },
            {
              "id": "agent.command.clear",
              "label": "/clear",
              "insert_text": "/clear",
              "description": "Clear the visible conversation"
            },
            {
              "id": "agent.command.new",
              "label": "/new",
              "insert_text": "/new",
              "description": "Start a new session"
            }
          ]
        }
      },
      {
        "key": "tui-workspace-suggestions",
        "package": "lenso.agent.tui-workspace-suggestions",
        "configuration": {
          "root": "."
        }
      },
      {
        "key": "workspace-import-read",
        "package": "lenso.agent.workspace-import-read",
        "configuration": {
          "root": "."
        }
      },
      {
        "key": "workspace-read",
        "package": "lenso.agent.workspace-read",
        "configuration": {
          "root": "."
        }
      }
    ],
    "binding_policies": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "tools",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      },
      {
        "consumer": "tools",
        "capability_id": "lenso.agent.tool-provider@2",
        "provider": "workspace-read",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      },
      {
        "consumer": "subagent-agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "restricted-read-tools",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      }
    ],
    "decisions": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "tools"
      },
      {
        "consumer": "cli",
        "capability_id": "lenso.agent@3",
        "provider": "agent"
      },
      {
        "consumer": "discord",
        "capability_id": "lenso.agent@3",
        "provider": "agent"
      },
      {
        "consumer": "subagent-agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "restricted-read-tools"
      },
      {
        "consumer": "telegram",
        "capability_id": "lenso.agent@3",
        "provider": "agent"
      },
      {
        "consumer": "tui",
        "capability_id": "lenso.agent@3",
        "provider": "agent"
      }
    ],
    "execution_lanes": [
      {
        "id": "main"
      }
    ]
  }
}
