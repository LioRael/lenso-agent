{
  "schema_version": 1,
  "manifest": "../../../../Cargo.toml",
  "host_package": "lenso-agent-cli",
  "packages": {
    "lenso.agent.cli": "lenso-agent-cli-module",
    "lenso.agent.loop": "lenso-agent-loop-module",
    "lenso.agent.model.openai-compatible": "lenso-agent-model-openai-compatible-module",
    "lenso.secrets.env": "lenso-secrets-env-module",
    "lenso.agent.prompt": "lenso-agent-prompt-module",
    "lenso.agent.prompt.static": "lenso-agent-prompt-static-module",
    "lenso.agent.session.file": "lenso-agent-session-file-module",
    "lenso.agent.tools": "lenso-agent-tools-module",
    "lenso.agent.workspace-read": "lenso-agent-workspace-read-module",
    "lenso.agent.workspace-import-read": "lenso-agent-workspace-import-read-module",
    "lenso.agent.workspace-read-tools": "lenso-agent-workspace-read-tools-module"
  },
  "app": {
    "name": "openai-readonly",
    "modules": [
      {
        "key": "agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "max_history_events": 200,
          "max_output_tokens": 1024,
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_parallel_tool_calls": 4,
          "model": "gpt-4o-mini"
        }
      },
      {
        "key": "cli",
        "package": "lenso.agent.cli",
        "configuration": {}
      },
      {
        "key": "default-instructions",
        "package": "lenso.agent.prompt.static",
        "configuration": {
          "contributions": [
            {
              "content": "Be concise, follow explicit user instructions, and use only the Tools supplied by this App.",
              "id": "harness.default",
              "kind": "instruction",
              "version": "1.0.0"
            }
          ]
        }
      },
      {
        "key": "model",
        "package": "lenso.agent.model.openai-compatible",
        "configuration": {
          "api_key_ref": "model/openai-api-key",
          "base_url": "https://api.openai.com/v1",
          "model": "gpt-4o-mini"
        }
      },
      {
        "key": "prompt",
        "package": "lenso.agent.prompt",
        "configuration": {
          "max_contributions": 16,
          "max_total_bytes": 65536
        }
      },
      {
        "key": "secrets",
        "package": "lenso.secrets.env",
        "configuration": {
          "references": {
            "model/openai-api-key": "OPENAI_API_KEY"
          }
        }
      },
      {
        "key": "sessions",
        "package": "lenso.agent.session.file",
        "configuration": {
          "directory": ".lenso/sessions"
        }
      },
      {
        "key": "summary-skill",
        "package": "lenso.agent.prompt.static",
        "configuration": {
          "contributions": [
            {
              "content": "When summarizing a workspace file, ground the answer in the Tool result.",
              "id": "workspace.summary",
              "kind": "skill",
              "version": "1.0.0"
            }
          ]
        }
      },
      {
        "key": "tools",
        "package": "lenso.agent.tools",
        "configuration": {}
      },
      {
        "key": "subagent-agent",
        "package": "lenso.agent.loop",
        "configuration": {
          "max_history_events": 200,
          "max_output_tokens": 1024,
          "max_steps": 8,
          "max_tool_calls": 4,
          "max_parallel_tool_calls": 4,
          "model": "gpt-4o-mini"
        }
      },
      {
        "key": "subagent-tools",
        "package": "lenso.agent.workspace-read-tools",
        "configuration": {}
      },
      {
        "key": "workspace-import-read",
        "package": "lenso.agent.workspace-import-read",
        "configuration": {
          "root": ".",
          "max_output_bytes": 1048576
        }
      },
      {
        "key": "workspace-read",
        "package": "lenso.agent.workspace-read",
        "configuration": {
          "max_list_entries": 1000,
          "max_output_bytes": 1048576,
          "max_search_bytes": 16777216,
          "max_search_entries": 10000,
          "max_search_matches": 1000,
          "root": "."
        }
      }
    ],
    "binding_policies": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "tools",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      },
      {
        "consumer": "tools",
        "capability_id": "lenso.agent.tool-provider@2",
        "provider": "workspace-read",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      },
      {
        "consumer": "subagent-agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "subagent-tools",
        "admission": {
          "queue_capacity": 0,
          "max_concurrency": 4
        }
      }
    ],
    "decisions": [
      {
        "consumer": "agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "tools"
      },
      {
        "consumer": "cli",
        "capability_id": "lenso.agent@3",
        "provider": "agent"
      },
      {
        "consumer": "subagent-agent",
        "capability_id": "lenso.agent.tools@2",
        "provider": "subagent-tools"
      }
    ],
    "execution_lanes": [
      {
        "id": "main"
      }
    ]
  }
}
