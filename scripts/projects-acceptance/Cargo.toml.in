[package]
name="projects-browser-acceptance"
version="0.0.0"
edition="2024"
publish=false
[workspace]
[dependencies]
lenso-app-plan="0.4.1"
lenso-kernel="0.3.6"
lenso-native-adapter="0.3.13"
lenso-runner="0.2.13"
lenso-capability-secrets="0.1.4"
lenso-capability-http-endpoint="0.3.0"
lenso-capability-agent-tool-provider="0.2.2"
lenso-organization-postgres-plugin="0.5.0"
lenso-capability-organization-admin="0.4.0"
lenso-capability-organization-directory="0.3.0"
lenso-capability-organization-membership="0.2.0"
lenso-capability-organization-membership-admin="0.3.0"
lenso-access-control-postgres-plugin="0.2.0"
lenso-capability-access-control-admin="0.2.0"
lenso-capability-access-control="0.2.0"
lenso-capability-access-control-directory="0.2.0"
serde_json="1"
serde_urlencoded="0.7"
axum="0.8"
uuid="1"
lenso-auth-sdk={path="@AUTH_ROOT@/crates/lenso-auth-sdk"}
lenso-auth-account-plugin={path="@AUTH_ROOT@/crates/lenso-auth-account-plugin"}
lenso-auth-password-plugin={path="@AUTH_ROOT@/crates/lenso-auth-password-plugin"}
lenso-auth-agent-connection-plugin={path="@AUTH_ROOT@/crates/lenso-auth-agent-connection-plugin"}
lenso-capability-password-auth={path="@AUTH_ROOT@/crates/lenso-capability-password-auth"}
lenso-capability-auth={path="@AUTH_ROOT@/crates/lenso-capability-auth"}
lenso-capability-auth-delegation={path="@AUTH_ROOT@/crates/lenso-capability-auth-delegation"}
lenso-capability-identity-directory={path="@AUTH_ROOT@/crates/lenso-capability-identity-directory"}
lenso-capability-credential-issuer={path="@AUTH_ROOT@/crates/lenso-capability-credential-issuer"}
lenso-projects-web-plugin={path="@PROJECTS_WEB_ROOT@"}
lenso-projects-postgres-plugin={path="@PROJECTS_ROOT@/crates/lenso-projects-postgres-plugin"}
lenso-projects-agent-tools-plugin={path="@PROJECTS_ROOT@/crates/lenso-projects-agent-tools-plugin"}
lenso-projects-agent-web-plugin={path="@PROJECTS_ROOT@/crates/lenso-projects-agent-web-plugin"}
lenso-capability-projects={path="@PROJECTS_ROOT@/crates/lenso-capability-projects"}
lenso-capability-projects-admin={path="@PROJECTS_ROOT@/crates/lenso-capability-projects-admin"}
lenso-capability-projects-collaboration={path="@PROJECTS_ROOT@/crates/lenso-capability-projects-collaboration"}
tokio={version="1.52",features=["full"]}
serde={version="1",features=["derive"]}
sqlx={version="0.9",default-features=false,features=["runtime-tokio","postgres","tls-rustls"]}
[patch.crates-io]
lenso-auth-sdk={path="@AUTH_ROOT@/crates/lenso-auth-sdk"}
lenso-capability-auth={path="@AUTH_ROOT@/crates/lenso-capability-auth"}

lenso-capability-projects={path="@PROJECTS_ROOT@/crates/lenso-capability-projects"}
lenso-capability-projects-admin={path="@PROJECTS_ROOT@/crates/lenso-capability-projects-admin"}
lenso-capability-projects-collaboration={path="@PROJECTS_ROOT@/crates/lenso-capability-projects-collaboration"}
